{
  "baseBranch": "auto",
  "browser": {
    "provider": "agent-browser"
  },
  "ci": {
    "maxWaitMinutes": 40
  },
  "closeKeywords": [],
  "engine": {
    "executorTier": "standard",
    "loopStepThreshold": 20,
    "stepReview": "final"
  },
  "labels": {
    "category": [
      "bug",
      "feature",
      "refactor",
      "security",
      "dependencies",
      "documentation"
    ],
    "enabled": true,
    "meta": [
      "needs-qa",
      "skip-qa",
      "qa-approved",
      "qa-self-verified",
      "in-progress",
      "ci-monitoring"
    ],
    "pipeline": [
      "review",
      "changes-requested",
      "qa",
      "qa-failed",
      "merge-queue",
      "blocked",
      "do-not-merge"
    ],
    "priority": [
      "priority-low",
      "priority-medium",
      "priority-high",
      "priority-extreme"
    ],
    "risk": [
      "risk-low",
      "risk-medium",
      "risk-high"
    ]
  },
  "paths": {
    "analysis": ".ai/analysis",
    "dataModel": ".ai/data-model",
    "prototypes": ".ai/prototypes",
    "qa": ".ai/qa",
    "runs": ".ai/runs",
    "scripts": ".ai/scripts",
    "specs": ".ai/specs"
  },
  "qaGate": true,
  "reviewChecklist": null,
  "tracker": "github",
  "validation": {
    "commands": [
      "yarn type-check:ci --force",
      "yarn lint",
      "TZ=UTC yarn test"
    ]
  },
  "version": 1
}
