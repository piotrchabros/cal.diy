{
  "name": "@calcom/notetaker-bot",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "esbuild src/main.ts src/runnerMain.ts --bundle --platform=node --target=node20 --format=cjs --outdir=dist --external:playwright --external:playwright-core --external:ws",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "type-check": "yarn typecheck",
    "type-check:ci": "yarn typecheck",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "test": "TZ=UTC vitest run",
    "fake-events": "tsx scripts/fake-events.ts",
    "capture-google-state": "tsx scripts/capture-google-storage-state.ts",
    "meet-probe": "tsx scripts/meet-probe.ts"
  },
  "dependencies": {
    "@calcom/lib": "workspace:*",
    "playwright": "1.57.0",
    "ws": "8.18.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "@types/node": "20.17.23",
    "@types/ws": "8.18.1",
    "esbuild": "0.25.12",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.8"
  }
}
