# Shared HMAC secret; must equal NOTETAKER_BOT_SECRET of the web app. Required.
NOTETAKER_BOT_SECRET=
# Address the controller HTTP server binds to.
NOTETAKER_BOT_HOST=127.0.0.1
# Port the controller HTTP server listens on (the web app's NOTETAKER_BOT_URL points here).
NOTETAKER_BOT_PORT=4010
# Maximum number of meetings running at once; a join beyond it answers 503.
NOTETAKER_BOT_CAPACITY=10
# How a meeting runner is started: child_process (local development) or docker.
NOTETAKER_BOT_LAUNCHER=child_process
# Runner image name and tag; required when NOTETAKER_BOT_LAUNCHER=docker.
NOTETAKER_RUNNER_IMAGE=
# Unix socket of the Docker Engine API; used when NOTETAKER_BOT_LAUNCHER=docker.
NOTETAKER_DOCKER_SOCKET=/var/run/docker.sock
# Docker network the runner containers join; empty uses the engine default.
NOTETAKER_DOCKER_NETWORK=
# real joins meetings in a browser; fake runs a scripted meeting and is refused when NODE_ENV=production.
NOTETAKER_BOT_ADAPTER=real
# Length in seconds of the scripted meeting when NOTETAKER_BOT_ADAPTER=fake.
NOTETAKER_FAKE_MEETING_SECONDS=5
# Soniox API key; required when NOTETAKER_BOT_ADAPTER=real.
SONIOX_API_KEY=
# Soniox realtime WebSocket URL; empty uses the built-in default.
SONIOX_WS_URL=
# Soniox model name; empty uses the built-in default.
SONIOX_MODEL=
# How the bot enters Google Meet: guest (types the display name) or account (signs in).
NOTETAKER_GOOGLE_JOIN_MODE=guest
# Base64 of a Playwright storage-state JSON for account mode; decoded in memory, never written to disk.
NOTETAKER_GOOGLE_STORAGE_STATE_B64=
# Google account email for account mode when no storage state is given.
NOTETAKER_GOOGLE_ACCOUNT_EMAIL=
# Google account password for account mode when no storage state is given.
NOTETAKER_GOOGLE_ACCOUNT_PASSWORD=
# Browser channel Playwright launches.
NOTETAKER_CHROME_CHANNEL=chrome
# true runs the browser headless; false needs a display (Xvfb in the image).
NOTETAKER_CHROME_HEADLESS=false
# Log threshold: debug, info, warn, error or silent.
NOTETAKER_LOG_LEVEL=info
