# Installed by the owner as /etc/caldiy/agent-browser.env (root:root, mode 600) and passed to the
# container with --env-file. Never bake these values into the image.

# Shared with the web app (AGENT_BROWSER_SECRET in /root/cal.diy/.env). At least 32 characters:
#   openssl rand -hex 32
AGENT_BROWSER_SECRET=

# The ports are fixed by the published ports in caldiy-agent-browser.service; change both together.
# AGENT_BROWSER_HOST=0.0.0.0
# AGENT_BROWSER_CONTROL_PORT=4410
# AGENT_BROWSER_VIEWER_PORT=4411

# AGENT_BROWSER_MAX_SESSIONS=4
# AGENT_BROWSER_IDLE_TIMEOUT_SECONDS=600
# AGENT_BROWSER_MAX_SESSION_SECONDS=18000
# AGENT_BROWSER_SCREENCAST_FPS=12
# AGENT_BROWSER_JPEG_QUALITY=70
# AGENT_BROWSER_LOG_LEVEL=info

# The image sets false: the sandbox cannot start in a container on this host (see the Dockerfile).
# AGENT_BROWSER_CHROMIUM_SANDBOX=false
